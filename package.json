{
  "name": "chess-com-insights",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thieleju/chess-com-insights"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern src tests scripts *.config.ts",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "test": "vitest run",
    "test:junit": "vitest run --reporter=default --reporter=junit --outputFile.junit=tests/results.xml",
    "cover": "vitest run --coverage",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
